{
  "name": "dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/dashboard/src",
  "projectType": "application",
  "tags": ["type:app", "scope:dashboard"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/dashboard/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/dashboard/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/dashboard/tsconfig.json --pretty false"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/src/graphql/operations.graphql",
        "{workspaceRoot}/apps/gateway/src/graphql/schema.graphql"
      ],
      "outputs": ["{projectRoot}/src/graphql/__generated__"],
      "options": {
        "command": "graphql-codegen --config codegen.ts",
        "cwd": "apps/dashboard"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx jest --selectProjects browser --passWithNoTests"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/e2e.sh"
      }
    }
  }
}
