# Local infrastructure connection settings (T02).
# Copy to `.env` for local overrides. Never commit real credentials.

# Compose project
COMPOSE_FILE=docker/compose.yml

# ClickHouse HTTP (Bun @clickhouse/client) and native ports
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_URL=http://localhost:8123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
DATASET_VERSION=local-1
DATASET_EVENTS_STREAM=dataset-events:local-1
DATASET_EVENTS_MAXLEN=10000
# Gateway waits this long to form a relay batch; 0 disables the wait.
DATASET_EVENTS_COALESCE_WINDOW_MS=250
# More change events than this in one window are emitted as invalidations.
DATASET_EVENTS_COALESCE_THRESHOLD=100

# Producer gRPC ingestion and change publication (T20)
PRODUCER_HOST=127.0.0.1
PRODUCER_PORT=50051
PRODUCER_URL=http://127.0.0.1:50051
INGEST_SOURCE=apps/producer/data/raw/ui_demo.json
PRODUCER_BLOCK_SIZE=2000
PRODUCER_MAX_BLOCK_ROWS=10000
PRODUCER_MAX_CHANGES=500
# Development-only simulator; 0 is off.
PRODUCER_SIMULATE_CHANGES_INTERVAL_MS=0

# Gateway GraphQL response bound (valid range: 1-200)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
GRAPHQL_MAX_FIRST=200
# Local single-node CSV artifacts. Multi-replica gateways require shared storage.
EXPORT_DIR=.data/exports
# Reserved policy boundary; T24 currently uses one asynchronous streaming workflow.
EXPORT_SYNC_ROW_LIMIT=10000
# Export metadata and download availability (valid range: 60-604800 seconds).
EXPORT_TTL_SECONDS=3600
