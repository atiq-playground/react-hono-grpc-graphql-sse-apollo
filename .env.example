# Local infrastructure connection settings (T02).
# Copy to `.env` for local overrides. Never commit real credentials.
#
# VERIFICATION NOTE (2026-09-04): Docker daemon was unreachable here
# (/var/run/docker.sock missing — enable Docker Desktop WSL Integration).
# Files and scripts are ready; run the operator commands below once Docker works.

# Compose project
COMPOSE_FILE=docker/compose.yml

# ClickHouse HTTP (Bun @clickhouse/client) and native ports
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_URL=http://localhost:8123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Optional channel name used by the smoke subscribe/publish check
REDIS_SMOKE_CHANNEL=svd:infra:smoke
