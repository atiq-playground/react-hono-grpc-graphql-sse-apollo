{
  "name": "proto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/proto/src",
  "projectType": "library",
  "tags": ["type:package", "scope:proto"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b packages/proto/tsconfig.json --pretty false"
      }
    },
    "buf-lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "BUF_CACHE_DIR=.buf-cache bunx buf lint",
        "cwd": "packages/proto"
      }
    },
    "buf-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "BUF_CACHE_DIR=.buf-cache bunx buf generate",
        "cwd": "packages/proto"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --bun packages/proto/scripts/smoke.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx jest --selectProjects node --passWithNoTests --testPathPatterns=packages/proto"
      }
    }
  }
}
